<Application x:Class="MacroForge.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#050A08"/>
    <SolidColorBrush x:Key="Panel" Color="#0A130F"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#0E1B15"/>
    <SolidColorBrush x:Key="Stroke" Color="#1E3A2C"/>
    <SolidColorBrush x:Key="Accent" Color="#2CE58B"/>
    <SolidColorBrush x:Key="Text" Color="#EAFFF4"/>
    <SolidColorBrush x:Key="Muted" Color="#7FA894"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="InputBg" Color="#071009"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#0E1B15"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="#245C42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#16301F"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#2CE58B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2CE58B"/>
      <Setter Property="Foreground" Value="#04140C"/>
      <Setter Property="BorderBrush" Value="#2CE58B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#1E3A2C"/>
      <Setter Property="Foreground" Value="#B7D8C7"/>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#8FBFA7"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="box" Width="18" Height="18" Margin="0,0,10,0"
                      Background="#071009" BorderBrush="#4A7A64" BorderThickness="1.5" CornerRadius="3">
                <Path x:Name="mark" Data="M2,9 L7,14 L16,3" Stroke="#04140C" StrokeThickness="2"
                      Visibility="Collapsed" Stretch="Uniform" Margin="2"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#2CE58B"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#2CE58B"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="#2CE58B"/>
      <Setter Property="BorderBrush" Value="#245C42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Background" Value="#0A130F"/>
      <Setter Property="Foreground" Value="#2CE58B"/>
      <Setter Property="BorderBrush" Value="#1E3A2C"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Application.Resources>
</Application>
