<Window x:Class="MacroForge.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:local="clr-namespace:MacroForge.App"
 Title="MacroForge" Width="1536" Height="1024" MinWidth="1280" MinHeight="800"
 WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
 Background="{DynamicResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/><local:InverseBoolToVis x:Key="InvVis"/><local:ChoiceConverter x:Key="Choice"/>
  <Style x:Key="CardBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,18"/></Style>
  <Style x:Key="SectionTag" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="15" Background="{DynamicResource Bg}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource ChromeGlow}" CornerRadius="14,14,0,0">
    <DockPanel LastChildFill="False">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
      <Path Data="M0,28 L17,0 L30,0 L44,24 L31,46 L22,46 L34,25 L25,10 L21,10 L10,28 L21,28 L26,20 L31,29 L25,38 L5,38 Z" Fill="{DynamicResource Accent}" Width="40" Height="44" Stretch="Uniform"/>
      <StackPanel Margin="15,0,0,0"><TextBlock Text="MacroForge" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Control Beyond Limits" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
     </StackPanel>
     <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose"/>
     <Button DockPanel.Dock="Right" Content="□" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize"/>
     <Button DockPanel.Dock="Right" Content="—" Style="{StaticResource ChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize"/>
     <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource Stroke}" Margin="20,17"/>
     <Button DockPanel.Dock="Right" Width="224" Height="40" Margin="0,0,12,0" Tag="profiles" Click="OnNavigate" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="檢視目前設定檔與應用程式規則">
      <DockPanel Width="190"><TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Text="&#xE7FC;" FontSize="19" Margin="0,0,12,0"/><TextBlock DockPanel.Dock="Right" Text="⌄"/><TextBlock Text="{Binding ActiveProfileName}" TextTrimming="CharacterEllipsis"/></DockPanel>
     </Button>
     <TextBlock DockPanel.Dock="Right" Text="目前設定檔" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1" Margin="7,0,10,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/><ColumnDefinition Width="414"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="248"/></Grid.RowDefinitions>
    <DockPanel Grid.RowSpan="2" Margin="0,24,5,0">
     <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,160">
      <RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="test" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9CE;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="按鍵測試" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="device" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="裝置資訊" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="transfer" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="匯入 / 匯出" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="help" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="使用說明" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     </StackPanel>
     <StackPanel><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="home" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="首頁" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="mouse" Command="{Binding ShowMouseCommand}" IsChecked="{Binding IsMousePage, Mode=OneWay}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE962;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="滑鼠巨集" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="auto" Command="{Binding ShowAutoCommand}" IsChecked="{Binding IsAutoPage, Mode=OneWay}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="自動化任務" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Command="{Binding ShowLogCommand}" IsChecked="{Binding IsLogPage, Mode=OneWay}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D5;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="日誌" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton><RadioButton Style="{StaticResource NavItem}" GroupName="Navigation" Tag="settings" Click="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="20" Width="34" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="設定" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton></StackPanel>
    </DockPanel>
    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12,16,12,14" Visibility="{Binding ShowDeviceWorkspace, Converter={StaticResource BoolToVis}}">
     <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12" LastChildFill="True">
        <Button DockPanel.Dock="Right" Width="36" Height="36" Padding="0"
                VerticalAlignment="Center" HorizontalAlignment="Right"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding RedetectCommand}" ToolTip="重新掃描已連接的滑鼠">
          <TextBlock Text="＋" FontSize="20" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Margin="0,-2,0,0"/>
        </Button>
        <TextBlock Text="我的滑鼠" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConnectedSummary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,12,4,0"/>
      <ListBox ItemsSource="{Binding Mice}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid MinHeight="58"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <local:MouseArtwork Width="34" Height="60" AccentBrush="{DynamicResource Accent}" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding DisplayName}"/>
          <DockPanel Margin="0,9,0,0"><TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"><Run Text="{Binding ButtonCount, Mode=OneWay}"/><Run Text=" 個按鍵"/></TextBlock>
           <Ellipse Width="8" Height="8" Margin="0,0,5,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="False"><Setter Property="Fill" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
           <TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
          </DockPanel>
         </StackPanel>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{DynamicResource Stage}" Padding="0" Margin="0,0,8,0" Visibility="{Binding IsMousePage, Converter={StaticResource BoolToVis}}">
     <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="20,16">
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DeviceConnection}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel><TextBlock Text="{Binding DeviceTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CapabilityText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       </DockPanel>
      </Border>
      <Grid DockPanel.Dock="Bottom" Margin="18,0,18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><RadioButton Content="正面視圖" Style="{StaticResource Tile}" GroupName="View" IsChecked="{Binding IsFrontView}" Padding="25,8" Margin="0,0,4,0"/><RadioButton Content="側面視圖" Style="{StaticResource Tile}" GroupName="View" IsChecked="{Binding IsSideView}" Padding="25,8" Margin="0"/></StackPanel>
       <Button Grid.Column="1" Content="↻  重置視圖" Command="{Binding RestoreLayoutCommand}" Style="{StaticResource GhostButton}"/>
      </Grid>
      <Grid>
       <Viewbox Stretch="Uniform" Margin="10,0"><local:MouseLayoutCanvas x:Name="LayoutCanvas" SideView="{Binding IsSideView}" ToolTip="通用滑鼠示意圖；按鍵數量與設定來自目前裝置" ButtonLabels="{Binding ButtonLabels}" Buttons="{Binding Buttons}" Layout="{Binding Selected.Snapshot.Layout}" EditMode="{Binding EditLayout}" SelectedButtonId="{Binding SelectedButton.Id}" AccentBrush="{DynamicResource Accent}"/></Viewbox>
       <Border Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="9" Padding="20" Margin="20" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding LearningTitle}" FontSize="16" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding LearningHint}" TextWrapping="Wrap" Margin="0,10"/><Button Content="結束偵測" Command="{Binding StopLearnCommand}"/></StackPanel></Border>
      </Grid>
     </DockPanel>
    </Border>
            <!-- Center: automation page -->
        <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,12,0"
                Visibility="{Binding IsAutoPage, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="任務總覽" Style="{StaticResource SectionTag}"/>
                <TextBlock Text="自動化" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="全部開始" Style="{StaticResource PrimaryButton}" Command="{Binding StartAllCommand}" Margin="0,0,8,0"/>
                <Button Content="停止全部" Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="還沒有巨集。到「滑鼠」頁點一個按鍵並儲存。"
                       Visibility="{Binding HasNoJobs, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ScrollViewer Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="256" Margin="0,0,12,12" Padding="16" CornerRadius="6"
                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                      <StackPanel>
                        <DockPanel>
                          <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Top" Margin="8,6,0,0"
                                   Fill="{DynamicResource Accent}"
                                   Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap">
                          <Run Text="{Binding MouseName}"/><Run Text=" · "/><Run Text="{Binding ButtonName}"/>
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" FontSize="13">
                          <Run Text="{Binding StateText}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                          <Run Text="  "/><Run Text="{Binding IntervalText}" Foreground="{DynamicResource Muted}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ScopeLabel}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                          <Button Content="開始" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                  Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.StartJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="繼續" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                  Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="暫停" Style="{StaticResource GhostButton}"
                                  Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="停止" Style="{StaticResource DangerButton}"
                                  Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}"/>
                          <Button Content="刪除" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                  Command="{Binding DataContext.DeleteJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

    <!-- Log page -->
    <Border Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,0,0" Padding="20"
            Visibility="{Binding IsLogPage, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
            <Button Content="重新整理" Style="{StaticResource GhostButton}" Command="{Binding RefreshLogsCommand}" Margin="0,0,8,0" Padding="14,8"/>
            <Button Content="匯出日誌" Style="{StaticResource PrimaryButton}" Command="{Binding ExportLogsCommand}" Padding="16,8"/>
          </StackPanel>
          <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold">
              <Run FontFamily="Segoe Fluent Icons" Text="&#xE9D5;" FontSize="20"/>
              <Run Text="  日誌"/>
            </TextBlock>
            <TextBlock Text="查看系統運作記錄、事件、錯誤與版本變更" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterAllLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=all}"/>
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterActionLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=action}"/>
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterErrorLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=error}"/>
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterWarningLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=warning}"/>
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterVersionLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=version}"/>
          <RadioButton Style="{StaticResource LogFilterChip}" GroupName="LogFilter" Content="{Binding LogFilterSystemLabel}"
                       IsChecked="{Binding LogFilter, Converter={StaticResource Choice}, ConverterParameter=system}"/>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LogTimeOptions}" SelectedItem="{Binding LogTimeOption}" Width="120" Margin="8,0,0,0"/>
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevelOption}" Width="110"/>
          <TextBox Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                   VerticalContentAlignment="Center" Tag="search"
                   ToolTip="搜尋日誌內容（支援關鍵字）"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="{Binding LogTotalText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="‹" Style="{StaticResource GhostButton}" Command="{Binding LogPrevPageCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <ItemsControl ItemsSource="{Binding LogPageNumbers}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" MinWidth="32" Padding="8,4" Margin="0,0,4,0"
                          Command="{Binding DataContext.LogGoPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DataContext.LogPageIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="{Binding}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="›" Style="{StaticResource GhostButton}" Command="{Binding LogNextPageCommand}" Padding="10,4" Margin="6,0,0,0"/>
          </StackPanel>
        </DockPanel>

        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
          <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource ChromeSurface}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="時間" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="4,0"/>
                <TextBlock Grid.Column="1" Text="等級" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="4,0"/>
                <TextBlock Grid.Column="2" Text="類別" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="4,0"/>
                <TextBlock Grid.Column="3" Text="內容" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="4,0"/>
              </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleLogs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,14">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Top" Foreground="{DynamicResource Muted}" Margin="4,2,8,2"/>
                        <Border Grid.Column="1" VerticalAlignment="Top" Margin="4,0">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LogLevelBadge}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelLabel}" Value="操作">
                                  <Setter Property="Background" Value="#122C20"/><Setter Property="BorderBrush" Value="#52EF99"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LevelLabel}" Value="警告">
                                  <Setter Property="Background" Value="#2A2610"/><Setter Property="BorderBrush" Value="#E8D96A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LevelLabel}" Value="錯誤">
                                  <Setter Property="Background" Value="#2A1212"/><Setter Property="BorderBrush" Value="#FF6B6B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LevelLabel}" Value="版本">
                                  <Setter Property="Background" Value="#1E1630"/><Setter Property="BorderBrush" Value="#B388FF"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding LevelLabel}" FontSize="12">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7EB6E8"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding LevelLabel}" Value="操作"><Setter Property="Foreground" Value="#52EF99"/></DataTrigger>
                                  <DataTrigger Binding="{Binding LevelLabel}" Value="警告"><Setter Property="Foreground" Value="#E8D96A"/></DataTrigger>
                                  <DataTrigger Binding="{Binding LevelLabel}" Value="錯誤"><Setter Property="Foreground" Value="#FF6B6B"/></DataTrigger>
                                  <DataTrigger Binding="{Binding LevelLabel}" Value="版本"><Setter Property="Foreground" Value="#B388FF"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Top" Margin="4,2"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,2,8,2"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="3" Grid.RowSpan="2" Visibility="{Binding ShowDeviceWorkspace, Converter={StaticResource BoolToVis}}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="186"/></Grid.RowDefinitions>
     <Border Style="{StaticResource CardBorder}" Padding="16,18,14,14">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="儲存" Command="{Binding SaveBindingCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,4"/><TextBlock Text="按鍵設定" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="選取滑鼠上的按鍵，開始設定。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Visibility="{Binding HasSelectedButton, Converter={StaticResource InvVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Visibility="{Binding HasSelectedButton, Converter={StaticResource BoolToVis}}">
        <StackPanel Margin="0,0,4,8">
         <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,1" Padding="2,12" Margin="0,0,0,14"><DockPanel>
          <ToggleButton DockPanel.Dock="Right" Style="{StaticResource CyberSwitch}" IsChecked="{Binding BindingEnabled}" Content="啟用" ToolTip="儲存後套用此按鍵的巨集啟用狀態"/>
          <TextBlock Text="{Binding SelectedButton.DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
         </DockPanel></Border>
         <UniformGrid Columns="3" Margin="0,0,-8,12"><RadioButton Content="◎  預設按鍵" GroupName="Function" Style="{StaticResource Tile}" IsChecked="{Binding FunctionType, Converter={StaticResource Choice}, ConverterParameter=預設}" /><RadioButton Content="⌨  鍵盤按鍵" GroupName="Function" Style="{StaticResource Tile}" IsChecked="{Binding FunctionType, Converter={StaticResource Choice}, ConverterParameter=鍵盤}" /><RadioButton Content="♧  滑鼠按鍵" GroupName="Function" Style="{StaticResource Tile}" IsChecked="{Binding FunctionType, Converter={StaticResource Choice}, ConverterParameter=滑鼠}" /><RadioButton Content="◇  巨集" GroupName="Function" Style="{StaticResource Tile}" IsChecked="{Binding FunctionType, Converter={StaticResource Choice}, ConverterParameter=巨集}" /><RadioButton Content="▣  開啟程式" Style="{StaticResource Tile}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="目前巨集引擎尚未支援啟動程式"/><RadioButton Content="⊗  停用巨集" GroupName="Function" Style="{StaticResource Tile}" IsChecked="{Binding FunctionType, Converter={StaticResource Choice}, ConverterParameter=停用}" ToolTip="停用此按鍵的巨集，保留原生滑鼠輸入"/></UniformGrid>
         <StackPanel Visibility="{Binding IsKeyboardFunction, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"><Label Content="鍵盤按鍵"/><DockPanel><Button DockPanel.Dock="Right" Content="錄製" Command="{Binding RecordKeyboardCommand}"/><TextBlock Text="{Binding KeyboardKeysLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></DockPanel></StackPanel>
         <ComboBox ItemsSource="{x:Static local:MacroStep.ClickOptions}" SelectedItem="{Binding MouseAction}" Visibility="{Binding IsMouseFunction, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>
         <UniformGrid Columns="4" Margin="0,0,-8,10"><RadioButton Content="單次" GroupName="Trigger" Style="{StaticResource Tile}" IsChecked="{Binding TriggerMode, Converter={StaticResource Choice}, ConverterParameter=單次執行}" /><RadioButton Content="按住循環" GroupName="Trigger" Style="{StaticResource Tile}" IsChecked="{Binding TriggerMode, Converter={StaticResource Choice}, ConverterParameter=按住循環}" /><RadioButton Content="切換循環" GroupName="Trigger" Style="{StaticResource Tile}" IsChecked="{Binding TriggerMode, Converter={StaticResource Choice}, ConverterParameter=切換循環}" /><RadioButton Content="定時執行" GroupName="Trigger" Style="{StaticResource Tile}" IsChecked="{Binding TriggerMode, Converter={StaticResource Choice}, ConverterParameter=定時執行}" /></UniformGrid>
         <Grid Margin="0,2,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
          <TextBlock Text="執行間隔" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding IntervalValue, UpdateSourceTrigger=LostFocus}" Padding="12,10" Margin="0,0,8,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding IntervalUnits}" SelectedItem="{Binding IntervalUnit}"/>
         </Grid>
         <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="重複次數" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton Content="∞  循環" GroupName="CountMode" Style="{StaticResource Tile}" IsChecked="{Binding TriggerMode, Converter={StaticResource Choice}, ConverterParameter=切換循環}" Margin="0,0,8,0"/><RadioButton Content="固定次數" GroupName="CountMode" Style="{StaticResource Tile}" IsChecked="{Binding IsCountTrigger, Mode=OneWay}" Tag="count" Click="OnNavigate" Margin="0"/></StackPanel>
         </Grid>
         <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCountTrigger, Converter={StaticResource BoolToVis}}" Margin="90,-9,0,12"/>
         <Label Content="作用範圍"/><UniformGrid Columns="2" Margin="0,0,-8,4"><RadioButton Content="◯  全域" GroupName="Scope" Style="{StaticResource Tile}" IsChecked="{Binding ScopeGlobal}"/><RadioButton Content="◎  指定應用程式" GroupName="Scope" Style="{StaticResource Tile}" IsChecked="{Binding ScopeApps}"/></UniformGrid>
         <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="＋ 新增應用程式" Command="{Binding PickAppCommand}" Padding="9,8"/>
          <ItemsControl ItemsSource="{Binding Applications}" Margin="0,0,8,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource InputBg}" CornerRadius="7" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="12,8" Margin="0,0,0,6"><DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="8,4" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </DockPanel>

         <Expander Header="進階設定"><StackPanel Margin="0,4,0,0">
          <Button Content="{Binding EditLabel}" Command="{Binding ToggleEditCommand}" Margin="0,0,0,12"/><Label Content="按鍵名稱"/><DockPanel><Button DockPanel.Dock="Right" Content="套用" Command="{Binding RenameCommand}" Margin="6,0,0,0"/><TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
          <Label Content="離開指定程式時" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding LeaveOptions}" SelectedItem="{Binding LeavePolicy}"/>
          <CheckBox Content="完整路徑匹配" IsChecked="{Binding MatchPath}" Margin="0,12"/>
          <WrapPanel><Button Content="目前程式" Command="{Binding UseForegroundAppCommand}" Margin="0,0,6,6"/><Button Content="建立設定檔" Command="{Binding AddWorkProfileCommand}" Margin="0,0,6,6"/><Button Content="刪除此按鍵" Command="{Binding DeleteButtonCommand}" Margin="0,0,6,6"/></WrapPanel>
          <TextBlock Text="{Binding Limitation}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
         </StackPanel></Expander>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="16,16">
      <StackPanel><TextBlock Text="執行狀態" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding ExecutionLabel}" Foreground="{DynamicResource Accent}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding BindingName}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,10"><StackPanel><TextBlock Text="{Binding ExecutionCount}"/><TextBlock Text="{Binding ExecutionNext}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
       </Grid>
       <UniformGrid Columns="3"><Button Content="■  停止" Command="{Binding StopSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/><Button Content="Ⅱ  暫停" Command="{Binding PauseSelectedCommand}" Margin="0,0,8,0"/><Button Content="全部停止" Command="{Binding StopAllCommand}"/></UniformGrid>
      </StackPanel>
     </Border>
    </Grid>
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,8,8,0" Padding="0" Visibility="{Binding IsMousePage, Converter={StaticResource BoolToVis}}">
     <DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="18,10" Height="56"><DockPanel><Button DockPanel.Dock="Right" Content="▷  測試" Command="{Binding TestSelectedCommand}" Width="100" Margin="12,0,0,0"/><TextBlock Text="巨集序列  ·  " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Text="{Binding BindingName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Width="230" Height="34" VerticalAlignment="Center" Padding="10,6" VerticalContentAlignment="Center" HorizontalAlignment="Left" ToolTip="編輯巨集名稱"/></DockPanel></Border>
      <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="20,8,20,16"><Button Content="＋  鍵盤動作" Command="{Binding AddKeyStepCommand}" Margin="0,0,8,0"/><Button Content="＋  等待時間" Command="{Binding AddWaitStepCommand}" Margin="0,0,8,0"/><Button Content="＋  滑鼠動作" Command="{Binding AddClickStepCommand}"/></UniformGrid>
      <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSurface}" Padding="14,10" Visibility="{Binding IsRecordingKey, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding RecordBanner}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/></Border>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="20,14,14,8">
       <ItemsControl ItemsSource="{Binding MacroSteps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
         <Border Width="112" Height="104" CornerRadius="8" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource InputBg}"/><Style.Triggers><DataTrigger Binding="{Binding IsKey}" Value="True"><Setter Property="Background" Value="#441721"/><Setter Property="BorderBrush" Value="#743141"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
           <Button Content="{Binding KeyCap}" FontSize="26" FontFamily="Segoe UI Symbol, Segoe UI" Background="Transparent" BorderThickness="0" Padding="8,6" Margin="6,8,6,4" Command="{Binding DataContext.RecordKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}" ToolTip="{Binding KeyLabel}"/>
           <StackPanel VerticalAlignment="Center" Margin="10,8,10,4" Visibility="{Binding IsWait, Converter={StaticResource BoolToVis}}">
             <TextBlock Text="◷" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
             <TextBlock Text="ms" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
             <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontSize="15" Padding="8,4" Margin="2,0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="等待時間（毫秒）"/>
           </StackPanel>
           <ComboBox ItemsSource="{x:Static local:MacroStep.ClickOptions}" SelectedItem="{Binding ClickButton}" Visibility="{Binding IsClick, Converter={StaticResource BoolToVis}}" Margin="10,10,10,6" VerticalAlignment="Center"/>
           <Border Grid.Row="1" Background="#33000000" CornerRadius="0,0,7,7" Padding="10,0">
             <DockPanel>
               <Button DockPanel.Dock="Right" Content="×" Padding="8,0" Margin="6,0,0,0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="刪除此動作"/>
               <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" Margin="2,0,0,0"/>
             </DockPanel>
           </Border>
          </Grid>
         </Border><TextBlock Text="→" FontSize="21" Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </DockPanel>
    </Border>
   </Grid>
   <Border Grid.Row="2" Background="{DynamicResource ChromeGlow}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="16,10">
    <DockPanel>
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
       <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
         <TextBlock Text="RK" FontFamily="Segoe UI" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel VerticalAlignment="Center" Margin="12,0">
         <TextBlock FontFamily="Segoe UI" FontWeight="SemiBold">
           <Hyperlink NavigateUri="https://github.com/ReiKama414/macro-forge"
                      RequestNavigate="OnGitHubNavigate"
                      Foreground="{DynamicResource Accent}"
                      TextDecorations="None"
                      Cursor="Hand"
                      ToolTip="開啟 GitHub：ReiKama414/macro-forge">reiKama414</Hyperlink>
         </TextBlock>
         <TextBlock Text="github.com/ReiKama414" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
       </StackPanel>
     </StackPanel>
     <Button DockPanel.Dock="Right" Content="⚙" Style="{StaticResource ChromeButton}" Tag="settings" Click="OnNavigate" ToolTip="外觀設定"/>
     <TextBlock DockPanel.Dock="Right" Text="v0.1.0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0"/>
     <ToggleButton DockPanel.Dock="Right" Content="巨集總開關" IsChecked="{Binding Armed}" Style="{StaticResource CyberSwitch}" VerticalAlignment="Center" Margin="18,0,0,0"/>
     <StackPanel VerticalAlignment="Center" Margin="12,0,24,0"><TextBlock Text="{Binding ConnectedSummary}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
    </DockPanel>
   </Border>
         <!-- Overlays -->
      <Border Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding HasPendingNew, Converter={StaticResource BoolToVis}}"
              Background="#E008090A">
        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                CornerRadius="6" Padding="28" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <TextBlock Text="NEW DEVICE" Style="{StaticResource SectionTag}"/>
            <TextBlock Text="發現新的滑鼠" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding PendingNew.Physical.DisplayName}" Margin="0,12,0,0" FontSize="15"/>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Muted}" FontSize="12">
              <Run Text="偵測到 "/><Run Text="{Binding PendingNew.DetectedStandardButtons, Mode=OneWay}"/><Run Text=" 個標準按鍵"/>
            </TextBlock>
            <Button Content="建立裝置模型" Style="{StaticResource PrimaryButton}" Command="{Binding CreateModelCommand}" Margin="0,20,0,0"/>
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding AskScanAfterCreate, Converter={StaticResource BoolToVis}}"
              Background="#E008090A">
        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                CornerRadius="6" Padding="28" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <TextBlock Text="要現在掃描額外按鍵嗎？" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button Content="開始掃描" Style="{StaticResource PrimaryButton}" Command="{Binding StartScanAfterCreateCommand}" Margin="0,0,8,0"/>
              <Button Content="稍後" Style="{StaticResource GhostButton}" Command="{Binding SkipScanCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,26,0" Padding="14,10"
              Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4"
              Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Width="24" Height="20"
                  Command="{Binding DismissToastCommand}" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" FontSize="13"/>
        </DockPanel>
      </Border>

  </Grid>
 </Border>
</Window>
