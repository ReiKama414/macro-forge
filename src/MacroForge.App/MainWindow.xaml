<Window x:Class="MacroForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MacroForge.App"
        Title="MacroForge"
        Height="880" Width="1400"
        MinHeight="720" MinWidth="1180"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:InverseBoolToVis x:Key="InvVis"/>

    <Style x:Key="MouseTab" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMousePage}" Value="True">
          <Setter Property="Background" Value="#12281C"/>
          <Setter Property="Foreground" Value="#2CE58B"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AutoTab" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAutoPage}" Value="True">
          <Setter Property="Background" Value="#12281C"/>
          <Setter Property="Foreground" Value="#2CE58B"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="SectionTag" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#1E3A2C" BorderThickness="1" Background="{StaticResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Custom title bar -->
      <Border Grid.Row="0" Background="#071009" BorderBrush="#132A1E" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Margin="18,0,20,0" VerticalAlignment="Center"
                     FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}">
            <Run Text="◤"/><Run Text=" MACROFORGE"/>
          </TextBlock>
          <Button DockPanel.Dock="Left" Content="滑鼠" Style="{StaticResource MouseTab}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding ShowMouseCommand}"/>
          <Button DockPanel.Dock="Left" Content="自動化" Style="{StaticResource AutoTab}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding ShowAutoCommand}"/>

          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose"/>
          <Button DockPanel.Dock="Right" Content="▢" Style="{StaticResource ChromeButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize"/>
          <Button DockPanel.Dock="Right" Content="—" Style="{StaticResource ChromeButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize"/>
          <Button DockPanel.Dock="Right" Content="F12 全部停止" Style="{StaticResource DangerButton}"
                  Margin="0,7,14,7" Padding="12,0" FontSize="12"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding EmergencyStopCommand}"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="14,14,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <!-- Mouse list -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="MOUSE" Style="{StaticResource SectionTag}"/>
              <TextBlock Text="我的滑鼠" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Mice}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12">
                      <Run Text="{Binding ButtonCount, Mode=OneWay}"/><Run Text=" 鍵 · "/>
                      <Run Text="{Binding ConnectionLabel, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Center: mouse page -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0"
                Visibility="{Binding IsMousePage, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{Binding DeviceTitle}" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding DeviceSubtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                         Text="① 點按鍵　② 右側加動作　③ 儲存　④ 自動化頁開始"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button Content="掃描全部按鍵" Style="{StaticResource PrimaryButton}" Command="{Binding ScanAllCommand}" Margin="0,0,8,8"/>
              <Button Content="偵測單鍵" Style="{StaticResource GhostButton}" Command="{Binding LearnOneCommand}" Margin="0,0,8,8"/>
              <Button Content="停止" Style="{StaticResource GhostButton}" Command="{Binding StopLearnCommand}" Margin="0,0,8,8"/>
              <Button Content="{Binding EditLabel}" Style="{StaticResource GhostButton}" Command="{Binding ToggleEditCommand}" Margin="0,0,8,8"/>
              <Button Content="重新偵測" Style="{StaticResource GhostButton}" Command="{Binding RedetectCommand}" Margin="0,0,8,8"/>
              <Button Content="恢復預設" Style="{StaticResource GhostButton}" Command="{Binding RestoreLayoutCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <Grid>
              <local:MouseLayoutCanvas x:Name="LayoutCanvas"
                                       Buttons="{Binding Buttons}"
                                       Layout="{Binding Selected.Snapshot.Layout}"
                                       EditMode="{Binding EditLayout}"
                                       SelectedButtonId="{Binding SelectedButton.Id}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}"
                      Background="#E6050A08" BorderBrush="#2CE58B" BorderThickness="1"
                      CornerRadius="6" Padding="20" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="16">
                <StackPanel>
                  <TextBlock Text="{Binding LearningTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                  <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Foreground="{StaticResource Success}" Margin="0,2" FontSize="13">
                          <Run Text="✓ "/><Run Text="{Binding DisplayName}"/>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding LearningHint}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </DockPanel>
        </Border>

        <!-- Center: automation page -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0"
                Visibility="{Binding IsAutoPage, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="AUTOMATION" Style="{StaticResource SectionTag}"/>
                <TextBlock Text="自動化" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="全部開始" Style="{StaticResource PrimaryButton}" Command="{Binding StartAllCommand}" Margin="0,0,8,0"/>
                <Button Content="全部停止" Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="還沒有巨集。到「滑鼠」頁點一個按鍵並儲存。"
                       Visibility="{Binding HasNoJobs, Converter={StaticResource BoolToVis}}"
                       Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ScrollViewer Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="256" Margin="0,0,12,12" Padding="16" CornerRadius="6"
                            Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                      <StackPanel>
                        <DockPanel>
                          <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Top" Margin="8,6,0,0"
                                   Fill="{StaticResource Accent}"
                                   Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                          <Run Text="{Binding MouseName}"/><Run Text=" · "/><Run Text="{Binding ButtonName}"/>
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" FontSize="13">
                          <Run Text="{Binding StateText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                          <Run Text="  "/><Run Text="{Binding IntervalText}" Foreground="#7FA894"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ScopeLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                          <Button Content="開始" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                  Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.StartJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="繼續" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                  Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="暫停" Style="{StaticResource GhostButton}"
                                  Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}" Margin="0,0,8,0"/>
                          <Button Content="停止" Style="{StaticResource DangerButton}"
                                  Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.StopJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Id}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Right inspector -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="BUTTON" Style="{StaticResource SectionTag}"/>
              <TextBlock Text="先在中間點一個按鍵" Foreground="{StaticResource Muted}"
                         Visibility="{Binding HasSelectedButton, Converter={StaticResource InvVis}}"
                         Margin="0,10,0,0" TextWrapping="Wrap"/>
              <StackPanel Visibility="{Binding HasSelectedButton, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SelectedButton.DisplayName}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>

                <Label Content="名稱" Margin="0,14,0,0"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="套用" Style="{StaticResource GhostButton}" Command="{Binding RenameCommand}" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <Label Content="功能" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding FunctionOptions}" SelectedItem="{Binding FunctionType}"/>

                <Label Content="觸發模式" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding TriggerMode}"/>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <Label Content="間隔（500ms / 1s）"/>
                    <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Label Content="固定次數"/>
                    <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </Grid>

                <Label Content="巨集名稱" Margin="0,12,0,0"/>
                <TextBox Text="{Binding BindingName, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Visibility="{Binding IsMacroFunction, Converter={StaticResource BoolToVis}}">
                  <Label Content="動作流程" Margin="0,14,0,0"/>
                  <Border Visibility="{Binding IsRecordingKey, Converter={StaticResource BoolToVis}}"
                          Background="#12281C" BorderBrush="#2CE58B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding RecordBanner}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                  </Border>
                  <TextBlock Text="{Binding MacroPreview}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
                  <ItemsControl ItemsSource="{Binding MacroSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#071009" BorderBrush="#1E3A2C" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                          <StackPanel>
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}" Padding="10,4" Margin="8,0,0,0"
                                      Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                              <ComboBox ItemsSource="{x:Static local:MacroStep.KindOptions}" SelectedItem="{Binding Kind, Mode=TwoWay}"/>
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                              <TextBlock Text="{Binding KeyLabel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
                              <Button Content="錄製按鍵" Style="{StaticResource GhostButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                      Command="{Binding DataContext.RecordKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                            <DockPanel Visibility="{Binding IsWait, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                              <TextBlock DockPanel.Dock="Right" Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Muted}"/>
                              <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{x:Static local:MacroStep.ClickOptions}" Margin="0,8,0,0"
                                      SelectedItem="{Binding ClickButton, Mode=TwoWay}"
                                      Visibility="{Binding IsClick, Converter={StaticResource BoolToVis}}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel>
                    <Button Content="+ 按鍵盤" Style="{StaticResource GhostButton}" Command="{Binding AddKeyStepCommand}" Margin="0,0,8,8"/>
                    <Button Content="+ 等待" Style="{StaticResource GhostButton}" Command="{Binding AddWaitStepCommand}" Margin="0,0,8,8"/>
                    <Button Content="+ 點擊" Style="{StaticResource GhostButton}" Command="{Binding AddClickStepCommand}" Margin="0,0,8,8"/>
                  </WrapPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsMacroFunction, Converter={StaticResource InvVis}}">
                  <Label Content="鍵盤按鍵" Margin="0,12,0,0"/>
                  <TextBlock Text="{Binding KeyboardKeysLabel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
                  <Button Content="錄製按鍵" Style="{StaticResource GhostButton}" Command="{Binding RecordKeyboardCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <Label Content="作用範圍" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="全域" IsChecked="{Binding ScopeGlobal}"/>
                  <RadioButton Content="指定程式" IsChecked="{Binding ScopeApps}"/>
                </StackPanel>
                <TextBlock Text="{Binding AppsLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,8" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="選擇程式" Style="{StaticResource GhostButton}" Command="{Binding PickAppCommand}" Margin="0,0,8,8"/>
                  <Button Content="目前程式" Style="{StaticResource GhostButton}" Command="{Binding UseForegroundAppCommand}" Margin="0,0,8,8"/>
                  <Button Content="清除" Style="{StaticResource GhostButton}" Command="{Binding ClearAppsCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <CheckBox Content="完整路徑匹配" IsChecked="{Binding MatchPath}" Margin="0,4,0,8"/>

                <Label Content="離開程式時" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding LeaveOptions}" SelectedItem="{Binding LeavePolicy}"/>

                <Button Content="儲存並前往自動化" Style="{StaticResource PrimaryButton}" Command="{Binding SaveBindingCommand}" Margin="0,18,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="建立 Profile" Style="{StaticResource GhostButton}" Command="{Binding AddWorkProfileCommand}" Margin="0,0,8,8"/>
                  <Button Content="刪除此按鍵" Style="{StaticResource GhostButton}" Command="{Binding DeleteButtonCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding Limitation}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,10,0,0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Status strip -->
      <Border Grid.Row="2" Background="#071009" BorderBrush="#132A1E" BorderThickness="0,1,0,0" Padding="18,8">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Overlays -->
      <Border Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding HasPendingNew, Converter={StaticResource BoolToVis}}"
              Background="#D8050A08">
        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="6" Padding="28" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <TextBlock Text="NEW DEVICE" Style="{StaticResource SectionTag}"/>
            <TextBlock Text="發現新的滑鼠" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding PendingNew.Physical.DisplayName}" Margin="0,12,0,0" FontSize="15"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="12">
              <Run Text="偵測到 "/><Run Text="{Binding PendingNew.DetectedStandardButtons, Mode=OneWay}"/><Run Text=" 個標準按鍵"/>
            </TextBlock>
            <Button Content="建立裝置模型" Style="{StaticResource PrimaryButton}" Command="{Binding CreateModelCommand}" Margin="0,20,0,0"/>
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding AskScanAfterCreate, Converter={StaticResource BoolToVis}}"
              Background="#D8050A08">
        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="6" Padding="28" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel>
            <TextBlock Text="要現在掃描額外按鍵嗎？" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button Content="開始掃描" Style="{StaticResource PrimaryButton}" Command="{Binding StartScanAfterCreateCommand}" Margin="0,0,8,0"/>
              <Button Content="稍後" Style="{StaticResource GhostButton}" Command="{Binding SkipScanCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,26,0" Padding="14,10"
              Background="#0E1B15" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4"
              Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ChromeButton}" Width="24" Height="20"
                  Command="{Binding DismissToastCommand}" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" FontSize="13"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
